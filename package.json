{
  "name": "heydeer",
  "version": "0.0.0",
  "private": true,
  "description": "Review local changes with HeyDeer before opening a pull request",
  "type": "module",
  "bin": {
    "heydeer": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "bun build src/cli.ts --compile --minify --outfile dist/heydeer"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "bun": "1.4.4",
    "oxfmt": "^0.77.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
